// This is your Prisma schema file for Supabase PostgreSQL (Database: fuel_tracker)
// Learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Profile {
  id                String                 @id @default(uuid()) @db.Uuid
  email             String                 @unique
  fullName          String?                @map("full_name")
  avatarUrl         String?                @map("avatar_url")
  currencySymbol    String                 @default("Rs.") @map("currency_symbol")
  distanceUnit      String                 @default("km") @map("distance_unit")
  volumeUnit        String                 @default("L") @map("volume_unit")
  targetEfficiency  Float?                 @default(14.5) @map("target_efficiency")
  icloudSyncEnabled Boolean                @default(true) @map("icloud_sync_enabled")
  createdAt         DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)

  vehicles          Vehicle[]
  fuelEntries       FuelEntry[]
  tripEntries       TripEntry[]
  preTripEntries    PreTripEntry[]
  fuelPriceRecords  FuelPriceRecord[]
  maintenanceItems  MaintenanceSchedule[]

  @@map("profiles")
}

model Vehicle {
  id                        String                 @id @default(uuid()) @db.Uuid
  userId                    String                 @map("user_id") @db.Uuid
  name                      String
  make                      String
  model                     String
  year                      Int
  licensePlate              String?                @map("license_plate")
  tankCapacityLitres        Float                  @default(47.0) @map("tank_capacity_litres")
  fullRangeBenchmarkKm      Float                  @default(680.0) @map("full_range_benchmark_km")
  currentCumulativeOdometer Float                  @default(0.0) @map("current_cumulative_odometer")
  fuelType                  String                 @default("Petrol (95)") @map("fuel_type")
  currentFuelPrice          Float?                 @default(106.5) @map("current_fuel_price")
  isPrimary                 Boolean                @default(true) @map("is_primary")
  createdAt                 DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)

  profile                   Profile                @relation(fields: [userId], references: [id], onDelete: Cascade)
  fuelEntries               FuelEntry[]
  tripEntries               TripEntry[]
  preTripEntries            PreTripEntry[]
  maintenanceItems          MaintenanceSchedule[]

  @@map("vehicles")
}

model FuelEntry {
  id                     String    @id @default(uuid()) @db.Uuid
  userId                 String    @map("user_id") @db.Uuid
  vehicleId              String    @map("vehicle_id") @db.Uuid
  date                   DateTime  @db.Date
  time                   String?
  amountPaid             Float     @map("amount_paid")
  pricePerLitre          Float     @map("price_per_litre")
  litresFueled           Float     @map("litres_fueled")
  currentRangeGauge      Float     @map("current_range_gauge")
  afterFuelingRangeGauge Float?   @map("after_fueling_range_gauge")
  fuelStation            String?   @map("fuel_station")
  notes                  String?
  isFullTank             Boolean   @default(true) @map("is_full_tank")
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  profile                Profile   @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicle                Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([userId, vehicleId, date(sort: Desc)])
  @@map("fuel_entries")
}

model TripEntry {
  id                      String    @id @default(uuid()) @db.Uuid
  userId                  String    @map("user_id") @db.Uuid
  vehicleId               String    @map("vehicle_id") @db.Uuid
  date                    DateTime  @db.Date
  totalCumulativeOdometer Float     @map("total_cumulative_odometer")
  category                String    @default("Commute")
  notes                   String?
  createdAt               DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  profile                 Profile   @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicle                 Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([userId, vehicleId, date(sort: Asc)])
  @@map("trip_entries")
}

model PreTripEntry {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  vehicleId         String    @map("vehicle_id") @db.Uuid
  loggedAt          DateTime  @default(now()) @map("logged_at") @db.Timestamptz(6)
  currentRangeGauge Float     @map("current_range_gauge")
  tripPurpose       String?   @map("trip_purpose")
  notes             String?
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  profile           Profile   @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicle           Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([userId, vehicleId, loggedAt(sort: Desc)])
  @@map("pretrip_entries")
}

model FuelPriceRecord {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  price          Float
  effectiveMonth String    @map("effective_month")
  dateRecorded   DateTime  @default(now()) @map("date_recorded") @db.Timestamptz(6)
  notes          String?
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  profile        Profile   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("fuel_price_records")
}

model MaintenanceSchedule {
  id                  String    @id @default(uuid()) @db.Uuid
  userId              String    @map("user_id") @db.Uuid
  vehicleId           String    @map("vehicle_id") @db.Uuid
  title               String
  category            String
  intervalKm          Int       @map("interval_km")
  intervalMonths      Int?      @map("interval_months")
  lastServiceOdometer Float     @default(0.0) @map("last_service_odometer")
  lastServiceDate     DateTime  @map("last_service_date") @db.Date
  estimatedCost       Float?    @map("estimated_cost")
  priority            String    @default("Medium")
  notes               String?
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  profile             Profile   @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicle             Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
  @@map("maintenance_schedules")
}
