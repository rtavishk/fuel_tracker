# =========================================================
# Supabase PostgreSQL & Prisma Connection Variables
# =========================================================
# DATABASE_URL: Supabase PostgreSQL connection string (Transaction pooler on port 6543 or Session on port 5432)
# Example: postgresql://postgres.xxxxxx:your-password@aws-0-eu-central-1.pooler.supabase.com:6543/fuel_tracker?pgbouncer=true
DATABASE_URL="postgresql://postgres:password@localhost:5432/fuel_tracker"

# DIRECT_URL: Supabase direct connection string (port 5432) used for schema migrations & DDL
# Example: postgresql://postgres.xxxxxx:your-password@aws-0-eu-central-1.pooler.supabase.com:5432/fuel_tracker
DIRECT_URL="postgresql://postgres:password@localhost:5432/fuel_tracker"

# Optional Supabase API keys
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"

# =========================================================
# AI Telemetry Intelligence (Gemini)
# =========================================================
# GEMINI_API_KEY: Required for Gemini AI Telemetry Audits.
GEMINI_API_KEY=""

# APP_URL: URL where this applet is hosted.
APP_URL=""
